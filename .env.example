# SessionPilot for REAPER - Example Environment Configuration

# Server
PORT=3000

# Bridge: keep 0 for local mock mode, set to 1 to connect to a real REAPER
# instance via the JSON queue bridge.
USE_REAL_BRIDGE=0

# Bridge directory (used when USE_REAL_BRIDGE=1)
REAPER_BRIDGE_DIR=./reaper_bridge

# Optional: enables Claude fallback for ambiguous messages when configured.
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Required for AI mode (the agent). Account must have API credits. Falls back to Default mode if unset.

# Planner mode: heuristic (default), heuristic-only, or off
SESSIONPILOT_PLANNER_MODE=heuristic
